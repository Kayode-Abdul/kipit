{
    "name": "kipit",
    "version": "1.9.3",
    "description": "Kipit Desktop Client",
    "author": "Kipit",
    "type": "module",
    "main": "main.cjs",
    "scripts": {
        "dev": "vite",
        "build": "vite build",
        "desktop:start": "electron .",
        "desktop:build": "electron-builder"
    },
    "dependencies": {
        "cookie": "^0.7.0",
        "idb": "^8.0.0"
    },
    "devDependencies": {
        "@tailwindcss/forms": "^0.5.7",
        "@tailwindcss/typography": "^0.5.20",
        "alpinejs": "^3.4.2",
        "autoprefixer": "^10.4.19",
        "concurrently": "^10.0.5",
        "electron": "^43.4.0",
        "electron-builder": "^26.15.3",
        "laravel-vite-plugin": "^1.2.0",
        "postcss": "^8.5.13",
        "postcss-nesting": "^12.1.2",
        "tailwindcss": "^3.4.3",
        "vite": "^6.4.2"
    },
    "build": {
        "directories": {
            "output": "dist"
        },
        "generateUpdatesFilesForAllChannels": false,
        "appId": "com.kipit.pos",
        "artifactName": "kipit-${version}-${os}-${arch}.${ext}",
        "asar": false,
        "productName": "Kipit",
        "icon": "build/icon.png",
        "files": [
            "main.cjs",
            "server.php",
            "artisan",
            "app/**/*",
            "bootstrap/**/*",
            "config/**/*",
            "database/**/*",
            "!database/**/*.lock",
            "public/**/*",
            "!public/downloads/**/*",
            "!public/hot",
            "!public/**/*.lock",
            "resources/**/*",
            "routes/**/*",
            "storage/**/*",
            "vendor/**/*",
            "!vendor/nativephp/electron/resources/js/node_modules/**/*",
            "!vendor/nativephp/php-bin/**/*",
            "!vendor/nativephp/electron/resources/js/resources/app/public/downloads/**/*",
            "!**/public/downloads/**/*",
            "!node_modules/**/*",
            "!.git/**/*",
            "!tests/**/*",
            "!**/*.sqlite.lock",
            ".env",
            "composer.json",
            "composer.lock",
            "version.txt"
        ],
        "mac": {
            "category": "public.app-category.business",
            "target": [
                "dmg"
            ],
            "artifactName": "kipit-${version}-mac.${ext}"
        },
        "win": {
            "target": [
                {
                    "target": "nsis",
                    "arch": [
                        "x64"
                    ]
                }
            ],
            "artifactName": "kipit-${version}-setup.${ext}"
        },
        "nsis": {
            "oneClick": false,
            "perMachine": false,
            "allowToChangeInstallationDirectory": true,
            "allowElevation": true,
            "createDesktopShortcut": true,
            "createStartMenuShortcut": true,
            "shortcutName": "Kipit",
            "uninstallDisplayName": "Kipit",
            "installerLanguages": [
                "en_US"
            ],
            "displayLanguageSelector": false,
            "deleteAppDataOnUninstall": false,
            "runAfterFinish": true,
            "differentialPackage": false
        }
    }
}
